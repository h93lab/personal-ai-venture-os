# Venture OS — self-hosted VPS environment template
# Copy this file to .env and replace every CHANGE_ME value before starting Docker.
# Never commit .env or real credentials.

NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://venture_os:CHANGE_ME_DB_PASSWORD@db:3306/venture_os

# Local authentication. Use 0566 for the first install, then change it.
JWT_SECRET=CHANGE_ME_generate_a_long_random_32_plus_character_secret
LOCAL_AUTH_PIN=CHANGE_ME_4_to_12_digit_pin

# OpenAI-compatible AI provider. Examples: OpenAI, OpenRouter, Ollama, vLLM, or a private gateway.
AI_API_BASE_URL=https://api.openai.com
AI_API_KEY=CHANGE_ME_ai_provider_key
AI_MODEL=CHANGE_ME_model_id

# Optional direct integrations configured from Settings or environment.
GITHUB_TOKEN=CHANGE_ME_optional_github_token
TELEGRAM_BOT_TOKEN=CHANGE_ME_optional_telegram_bot_token
TELEGRAM_CHAT_ID=CHANGE_ME_optional_telegram_chat_id

# Internal token used by the Docker cron worker to call /api/scheduled/*.
# It may be set equal to JWT_SECRET, but a separate random value is preferred.
SCHEDULER_TOKEN=CHANGE_ME_scheduler_secret

# Optional browser smoke target
# VENTURE_OS_URL=https://your-domain.example

# Docker Compose database settings; keep these aligned with DATABASE_URL
MYSQL_DATABASE=venture_os
MYSQL_USER=venture_os
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_database_password
